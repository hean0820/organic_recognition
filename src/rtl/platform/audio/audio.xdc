set_property -dict {PACKAGE_PIN E18 IOSTANDARD LVCMOS33} [get_ports aud_scl]
set_property -dict {PACKAGE_PIN F17 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports aud_sda]
set_property -dict {PACKAGE_PIN M17 IOSTANDARD LVCMOS33} [get_ports aud_adcdat]
set_property -dict {PACKAGE_PIN G18 IOSTANDARD LVCMOS33} [get_ports aud_lrc]
set_property -dict {PACKAGE_PIN G17 IOSTANDARD LVCMOS33} [get_ports aud_dacdat]
set_property -dict {PACKAGE_PIN E19 IOSTANDARD LVCMOS33} [get_ports aud_mclk]
set_property -dict {PACKAGE_PIN M18 IOSTANDARD LVCMOS33} [get_ports aud_bclk]
set_property -dict {PACKAGE_PIN L14 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports voice_key_n]
set_property -dict {PACKAGE_PIN H15 IOSTANDARD LVCMOS33} [get_ports {voice_led[0]}]
set_property -dict {PACKAGE_PIN L15 IOSTANDARD LVCMOS33} [get_ports {voice_led[1]}]
create_clock -period 80.000 -name aud_bclk [get_ports aud_bclk]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets aud_bclk_IBUF]
set_clock_groups -asynchronous -group [get_clocks aud_bclk] -group [get_clocks -include_generated_clocks -filter {NAME !~ aud_bclk}]
set_input_delay -clock aud_bclk -max 50.0 [get_ports {aud_lrc aud_adcdat}]
set_input_delay -clock aud_bclk -min 0.0 [get_ports {aud_lrc aud_adcdat}]
set_false_path -from [get_ports voice_key_n]
# I2C driver's divided clock is generated from 100 MHz /100, not an async clock.
create_generated_clock -name codec_i2c -source [get_pins system_i/audio_axi_0/inst/s_axi_aclk] -divide_by 100 [get_pins system_i/audio_axi_0/inst/core/codec/u_i2c_dri/dri_clk_reg/Q]
